# Copy to tests/e2e/.env and fill in. Never commit the result.
#
# Use credentials that exist ONLY for testing. This tier mints installation
# tokens, calls the Anthropic API and pushes commits — point it at a dedicated
# GitHub App installed on one throwaway repository, not the App a real agent
# depends on. tests/e2e/run.sh hard-refuses to run against
# ~/.config/agent-creds for that reason.

# --- GitHub (dedicated test App) ---
# APP_ID:          https://github.com/settings/apps/<your-test-app>
# INSTALLATION_ID: https://github.com/settings/installations
# Private key:     ~/.config/agent-creds-e2e/github-app.pem
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Throwaway repository the test App is installed on, as owner/repo.
# 30-git.test.sh clones it, pushes a scratch branch and deletes the branch.
# Leave empty to skip the clone/push assertions.
E2E_TEST_REPO=

# --- Anthropic ---
# Not set here — write ONE of these files instead (auth token wins if both exist):
#   $AGENT_CREDS_DIR/anthropic.key         (API key, e.g. sk-ant-...)
#   $AGENT_CREDS_DIR/anthropic-auth.token   (OAuth token, e.g. sk-ant-oat01-...)

# --- GCP (optional; 40-gcp skips without it) ---
# Fill in these two, then run:
#
#   tests/e2e/run.sh setup gcp
#
# That creates the service account with no roles, grants your account
# permission to impersonate it, produces the ADC file, and writes
# GCP_SERVICE_ACCOUNT below. It checks before each step, so re-running is a
# no-op. It creates NO service-account key, and it does not touch your own
# application-default credentials.
#
# `tests/e2e/run.sh setup gcp --teardown` removes what it created.
GCP_PROJECT=
GCP_SA=sal-e2e-agent

# Written by `setup gcp`, derived as $GCP_SA@$GCP_PROJECT.iam.gserviceaccount.com.
# Set it by hand only if you provisioned the service account yourself — it is
# cross-checked against the impersonation URL inside gcp-adc.json, and a
# mismatch is a 403 rather than a silent preference.
GCP_SERVICE_ACCOUNT=

# Also written by `setup gcp`. Google's tokeninfo reports a service account by
# numeric id, never by email, so the suite needs this to confirm which
# principal a token belongs to. Without it that one assertion skips.
GCP_SA_UNIQUE_ID=

# The ADC file itself is not set here — `setup gcp` writes it to the creds
# directory, alongside github-app.pem:
#   $AGENT_CREDS_DIR/gcp-adc.json
