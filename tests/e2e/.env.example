# Copy to tests/e2e/.env and fill in. Never commit the result.
#
# Use credentials that exist ONLY for testing. This tier mints installation
# tokens, calls the Anthropic API and pushes commits — point it at a dedicated
# GitHub App installed on one throwaway repository, not the App a real agent
# depends on. tests/e2e/run.sh hard-refuses to run against
# ~/.config/agent-creds for that reason.

# --- GitHub (dedicated test App) ---
# APP_ID:          https://github.com/settings/apps/<your-test-app>
# INSTALLATION_ID: https://github.com/settings/installations
# Private key:     ~/.config/agent-creds-e2e/github-app.pem
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Throwaway repository the test App is installed on, as owner/repo.
# 30-git.test.sh clones it, pushes a scratch branch and deletes the branch.
# Leave empty to skip the clone/push assertions.
E2E_TEST_REPO=

# --- Anthropic ---
# Not set here — write ONE of these files instead (auth token wins if both exist):
#   $AGENT_CREDS_DIR/anthropic.key         (API key, e.g. sk-ant-...)
#   $AGENT_CREDS_DIR/anthropic-auth.token   (OAuth token, e.g. sk-ant-oat01-...)

# --- GCP (optional; 40-gcp skips without it) ---
# The service account this deployment impersonates. Full email. Cross-checked
# against the impersonation URL inside gcp-adc.json — a mismatch is a 403, not
# a silent preference. See README → GCP for the four gcloud commands.
GCP_SERVICE_ACCOUNT=

# A project the service account can be asked about. Only used to prove an
# injected call is not rejected as unauthenticated, so it does not need to
# exist and the SA does not need permission on it — a 403 proves the point as
# well as a 200 does. Leave empty to use a nonexistent name.
GCP_TEST_PROJECT=

# The ADC file itself is not set here — it is a file in the creds directory,
# same as github-app.pem:
#   $AGENT_CREDS_DIR/gcp-adc.json
