# GitHub App credentials
# Find APP_ID at: https://github.com/settings/apps/<your-app>
# Find INSTALLATION_ID at: https://github.com/settings/installations
# Private key file goes at ~/.config/agent-creds/github-app.pem
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Anthropic credentials are not set here — write ONE of these files instead
# (auth token takes priority if both are present):
#   ~/.config/agent-creds/anthropic.key         (API key, e.g. sk-ant-...)
#   ~/.config/agent-creds/anthropic-auth.token   (OAuth token, e.g. sk-ant-oat01-...; avoids API-tier rate limits)
